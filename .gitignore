# Runtime data. The dev JWT signing key lives here — never commit it, because
# anyone holding it can mint a token for any user.
api/App_Data/

# Built from reference/schema/*.sql in two commands. See reference/README.md.
reference/forge.db
*.db-wal
*.db-shm

# Editor and agent configuration, not part of the project.
.claude/
.vscode/
.idea/

node_modules/
.DS_Store

# Deployment scratch. Each host's CLI writes a local state directory; none of it
# belongs in the repository, and .vercel in particular holds a project id that
# links a clone to somebody else's account.
.wrangler/
.vercel/
.netlify/
